            "specifier": ">=0.1.0,<0.2.0"
          },
          "disposition": "required",
          "import_probe": "wb_prim_cell_vector_family"
        }
      ],
      "promotion_closure": {
        "path_scores": [
          "fit_summary",
          "path_scores"
        ],
        "fit_summary": [
          "fit_summary",
          "path_scores"
        ]
      },
      "replay_equivalence": {
        "path_scores": "exact_canonical_value",
        "fit_summary": "exact_canonical_value"
      },
      "retained_parameters": [
        {
          "name": "space_id",
          "source": "output_first_row",
          "output": "fit_summary",
          "field": "space_id"
        },
        {
          "name": "path_id",
          "source": "output_first_row",
          "output": "fit_summary",
          "field": "path_id"
        },
        {
          "name": "score_mode",
          "source": "effective_parameter_value",
          "required": true,
          "parameter": "score_mode"
        },
        {
          "name": "distance_metric",
          "source": "effective_parameter_value",
