{
  "schema_version": "scworkbench.operation_pack.v3",
  "pack_abi_version": "3",
  "identity_scheme": "scworkbench.operation_pack.canonical_json.v1",
  "namespace": "scwbtrajectory",
  "package": {
    "name": "scwbTrajectory",
    "version": "0.1.0"
  },
  "backend": "R",
  "compatibility": {
    "scworkbench": {
      "minimum": "0.1.0",
      "maximum_exclusive": "0.2.0"
    },
    "pack_abi": {
      "minimum": "3",
      "maximum": "3"
    }
  },
  "entry_point": "scwbTrajectory::register_operation_pack",
  "operations": [
    {
      "name": "trajectory_branch_compare",
      "qualified_name": "scwbtrajectory::trajectory_branch_compare",
      "title": "Trajectory Branch Compare",
      "description": "Compare two trajectory branches feature-by-feature using authenticated matrix, pseudotime, and branch-membership inputs.",
      "runner": ".run_trajectory_branch_compare",
      "inputs": [
        {
          "name": "matrix",
          "kind": "matrix",
          "required": true,
          "alignment": "cell_and_feature_ordered"
        },
        {
          "name": "pseudotime",
          "kind": "cell_vector_family",
          "required": true,
          "alignment": "cell_ordered"
        },
        {
          "name": "branch_membership",
          "kind": "relation_family",
          "required": true,
          "alignment": "cell_ordered"
        }
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "branch_a": {
            "type": ["string", "null"]
          },
          "branch_b": {
            "type": ["string", "null"]
          },
          "feature_set": {
            "type": ["string", "null"]
          },
          "features": {
            "type": ["array", "null"],
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "min_pct": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 1
          },
          "p_adjust_method": {
            "type": "string",
            "default": "BH"
          },
          "chunk_size": {
            "type": "integer",
            "default": 128,
            "minimum": 1,
            "maximum": 100000
          }
        },
        "additionalProperties": false
      },
      "registry_reads": [
        {
          "name": "feature_sets",
          "category": "authenticated_core_registry_snapshot",
          "kind": "feature_set_registry",
          "reader": "read_feature_set_registry",
          "matrix_input": "matrix",
          "no_selector_policy": "all_namespaces",
          "empty_match_policy": "allow"
        }
      ],
      "dimension_policies": [
        {
          "output": "branch_de_table",
          "policy": "data_dependent_table_v1"
        },
        {
          "output": "branch_summary",
          "policy": "data_dependent_table_v1"
        }
      ],
      "outputs": [
        {
          "name": "branch_de_table",
          "category": "terminal_artifact",
          "kind": "feature_table",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "branch_de_table_id",
          "required": true,
          "promotion_group": "branch",
          "table_type": "trajectory_branch_compare"
        },
        {
          "name": "branch_summary",
          "category": "terminal_artifact",
          "kind": "obs_table",
          "storage_profile": "terminal_primitive_v1",
          "allocated_id_key": "branch_summary_id",
          "required": true,
          "promotion_group": "branch",
          "table_type": "trajectory_branch_compare_summary"
        }
      ],
      "dependencies": [
        {
          "requirement_id": "scworkbench_runtime",
          "kind": "r_package",
          "name": "scworkbench",
          "version": {
            "scheme": "r_package_version_constraint_v1",
            "specifier": ">=0.1.0,<0.2.0"
          },
          "disposition": "required",
          "import_probe": "wb_prim_feature_table"
        }
      ],
      "promotion_closure": {
        "branch_de_table": [
          "branch_de_table",
          "branch_summary"
        ],
        "branch_summary": [
          "branch_de_table",
          "branch_summary"
        ]
      },
      "replay_equivalence": {
        "branch_de_table": "exact_canonical_value",
        "branch_summary": "exact_canonical_value"
      },
      "typed_slice_reads": [
        {
          "name": "matrix_chunks",
          "input": "matrix",
          "reader": "read_typed_slices",
          "kind": "matrix",
          "supported_axes": [
            "features"
          ],
          "chunk_axis": "features",
          "chunk_size_parameter": "chunk_size",
          "call_discipline": "ordered_partition_exactly_once",
          "empty_selection_policy": "reject",
          "duplicate_policy": "reject",
          "selection": {
            "cells": {
              "policy": "effective_input_axis_v1"
            },
            "features": {
              "policy": "effective_input_axis_v1"
            }
          }
        }
      ],
      "retained_parameters": [
        {
          "name": "matrix_id",
          "source": "output_meta",
          "output": "branch_de_table",
          "field": "matrix_id"
        },
        {
          "name": "branch_a",
          "source": "parameter_value",
          "required": true,
          "parameter": "branch_a"
        },
        {
          "name": "branch_b",
          "source": "parameter_value",
          "required": true,
          "parameter": "branch_b"
        },
        {
          "name": "n_cells_a",
          "source": "output_first_row",
          "output": "branch_summary",
          "field": "n_cells_a"
        },
        {
          "name": "n_cells_b",
          "source": "output_first_row",
          "output": "branch_summary",
          "field": "n_cells_b"
        },
        {
          "name": "n_overlap_dropped",
          "source": "output_first_row",
          "output": "branch_summary",
          "field": "n_overlap_dropped"
        },
        {
          "name": "n_features",
          "source": "output_first_row",
          "output": "branch_summary",
          "field": "n_features_tested"
        },
        {
          "name": "min_pct",
          "source": "effective_parameter_value",
          "required": true,
          "parameter": "min_pct"
        },
        {
          "name": "p_adjust_method",
          "source": "effective_parameter_value",
          "required": true,
          "parameter": "p_adjust_method"
        }
      ],
      "public_interface": {
        "intent": [
          "trajectory",
          "comparison",
          "statistics"
        ],
        "inputs": [
          {
            "name": "matrix",
            "label": "matrix",
            "help": "Typed matrix input."
          },
          {
            "name": "pseudotime",
            "label": "pseudotime",
            "help": "Typed pseudotime input."
          },
          {
            "name": "branch_membership",
            "label": "branch_membership",
            "help": "Typed branch_membership input."
          }
        ],
        "parameters": [
          {
            "name": "branch_a",
            "type": "string",
            "help": "Branch/lineage key A."
          },
          {
            "name": "branch_b",
            "type": "string",
            "help": "Branch/lineage key B."
          },
          {
            "name": "feature_set",
            "type": "string",
            "help": "Optional matrix feature-set name."
          },
          {
            "name": "features",
            "type": "string_vec",
            "help": "Optional explicit feature IDs."
          },
          {
            "name": "min_pct",
            "type": "dbl",
            "help": "Minimum detection fraction."
          },
          {
            "name": "p_adjust_method",
            "type": "string",
            "help": "P-value adjustment method."
          },
          {
            "name": "chunk_size",
            "type": "int",
            "help": "Authenticated feature chunk size."
          }
        ],
        "outputs": [
          {
            "name": "branch_de_table",
            "description": "Declared branch_de_table terminal."
          },
          {
            "name": "branch_summary",
            "description": "Declared branch_summary terminal."
          }
        ]
      }
    },
