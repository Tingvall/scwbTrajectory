          "trajectory",
          "geometry",
          "path"
        ],
        "inputs": [
          {
            "name": "space",
            "label": "space",
            "help": "Typed space input."
          },
          {
            "name": "path",
            "label": "path",
            "help": "Typed path input."
          }
        ],
        "parameters": [
          {
            "name": "score_mode",
            "type": "choice",
            "help": "Orthogonal-projection scoring mode."
