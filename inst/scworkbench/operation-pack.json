    {
      "name": "space_path_score",
      "qualified_name": "scwbtrajectory::space_path_score",
      "title": "Score cells against analytical path",
      "description": "Score authenticated space cells by projection onto an analytical path.",
      "runner": ".run_space_path_score",
      "inputs": [
        {
          "name": "space",
          "kind": "space",
          "required": true,
          "alignment": "cell_ordered"
        },
        {
          "name": "path",
          "kind": "space_path_family",
          "required": true,
          "alignment": "associated_space"
        }
      ],
      "params_schema": {
        "type": "object",
        "properties": {
          "score_mode": {
            "type": "string",
            "default": "orthogonal_projection",
            "enum": [
              "orthogonal_projection"
            ]
          },
          "distance_metric": {
            "type": "string",
            "default": "euclidean",
            "enum": [
              "euclidean"
            ]
          },
          "score_prefix": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      },
      "dimension_policies": [
        {
          "output": "path_scores",
          "policy": "authenticated_output_axes_v1",
          "shape": "cell_key_cartesian",
          "cell_axis": {
            "source": "effective_cells_v1",
            "input": "space"
          },
          "key_axis": {
            "source": "declared_keys_with_optional_prefix_v1",
            "keys": [
              "progress",
              "distance",
              "nearest_segment",
              "nearest_anchor"
            ],
            "prefix_parameter": "score_prefix"
          },
          "row_order": "key_major_then_cell_v1",
          "missing_values": "forbidden"
        },
        {
          "output": "fit_summary",
          "policy": "data_dependent_table_v1"
        }
      ],
      "outputs": [
